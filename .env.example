# ========================================================
# ParkSmart - Environment Configuration Example
# ========================================================

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/parksmart
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/parksmart?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/parksmart

# NextAuth / Auth Session Secret
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET=development-secret-must-be-at-least-32-characters-long
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
